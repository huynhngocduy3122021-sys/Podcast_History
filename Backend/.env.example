# Endpoint trong Cloudflare Dashboard > R2 > Overview/API.
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# Tạo R2 API token có quyền Object Read & Write cho bucket này.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Thay bằng chuỗi bí mật ngẫu nhiên tối thiểu 32 ký tự.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# URL domain public của bucket (R2.dev hoặc custom domain), để trống nếu chưa bật public access.
R2_PUBLIC_BASE_URL=

R2_REGION=auto
R2_FOLDER=podcast-history
MEDIA_UPLOAD_MAX_FILE_SIZE=100MB
# Tạm tắt hai loại gói. Đổi thành true để bật lại từng loại.
CREATOR_PLANS_ENABLED=false
MEMBERSHIPS_ENABLED=false

# AI hỗ trợ Admin duyệt podcast. Thiếu key thì kết quả sẽ là SKIPPED.
GEMINI_API_KEY=
GEMINI_MODERATION_MODEL=gemini-3.6-flash
WHISPER_SERVICE_URL=http://127.0.0.1:8092
WHISPER_SERVICE_TOKEN=

# Tạm tắt hai loại gói. Đổi thành true để bật lại từng loại.
CREATOR_PLANS_ENABLED=false
MEMBERSHIPS_ENABLED=false

# Agora Console > Projects > project của bạn. Chỉ App ID được trả cho frontend.
# App Certificate phải giữ ở backend; bật APP ID + Token trong Agora Console.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_TTL_SECONDS=3600
# SePay QR and webhook configuration.
SEPAY_QR_BASE_URL=https://vietqr.app/img
SEPAY_BANK_CODE=
SEPAY_BANK_ACCOUNT=
SEPAY_WEBHOOK_API_KEY=

# Must match SePay's configured "Cấu trúc mã thanh toán":
# prefix, suffix length, and allowed suffix characters (A-Z and 0-9).
SEPAY_CODE_PREFIX=DH
SEPAY_CODE_SUFFIX_LENGTH=14

