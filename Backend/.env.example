# Endpoint trong Cloudflare Dashboard > R2 > Overview/API.
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# Tạo R2 API token có quyền Object Read & Write cho bucket này.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Thay bằng chuỗi bí mật ngẫu nhiên tối thiểu 32 ký tự.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# URL domain public của bucket (R2.dev hoặc custom domain), để trống nếu chưa bật public access.
R2_PUBLIC_BASE_URL=

R2_REGION=auto
R2_FOLDER=podcast-history
MEDIA_UPLOAD_MAX_FILE_SIZE=100MB

# SePay webhook API key; configure the same key in the SePay webhook settings.
SEPAY_WEBHOOK_API_KEY=

# Bank account details used to generate membership QR codes.
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK=

# Prefix for unique transfer descriptions, for example MEM.
SEPAY_PAYMENT_CODE_PREFIX=
